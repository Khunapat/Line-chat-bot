{
  "name": "line-drive-archiver",
  "version": "1.0.0",
  "description": "LINE chatbot that archives everything you send it (links, photos, videos, files) into Google Drive",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "get-token": "node scripts/get-refresh-token.js",
    "rich-menu": "node scripts/setup-rich-menu.js",
    "set-webhook": "node scripts/set-webhook.js",
    "setup": "bash scripts/setup.sh",
    "check": "for f in src/*.js scripts/*.js; do node --check $f || exit 1; done",
    "test": "node --test",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/genai": "^2.21.0",
    "@line/bot-sdk": "^9.5.0",
    "express": "^4.21.2",
    "googleapis": "^144.0.0"
  },
  "license": "MIT"
}
