# Copy to .env (never commit .env). Every variable is optional.

# Which AI to use: gemini | anthropic | mock.
# Leave empty to auto-detect: GEMINI_API_KEY -> gemini, else ANTHROPIC_API_KEY -> anthropic,
# else mock (demo mode: canned offline replies, no key needed).
LLM_PROVIDER=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma list: later models are fallbacks when the first one's free quota runs out.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Claude instead of Gemini (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low

# Language the partner uses when it has to explain something: en | th
EXPLAIN_LANG=en

# Set this when the app is on the internet so only you can use your AI quota.
APP_PASSWORD=

# Port to listen on (Cloud Run sets this itself).
PORT=8090

# Where the session log (log.json) is kept. Default: speaking-app/data
DATA_DIR=
