# ---- LINE Messaging API (LINE Developers Console > your channel) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Your own LINE user ID (starts with "U"). Leave empty on first deploy;
# the bot replies with your ID so you can copy it here. Comma-separate
# several IDs to allow more than one person.
ALLOWED_USER_IDS=

# ---- Google (Google Cloud Console > OAuth client, "Desktop app") ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced once by `npm run get-token` (grants Drive + Calendar)
GOOGLE_REFRESH_TOKEN=
# Which calendar "ลง calendar ..." writes to (default: primary)
GOOGLE_CALENDAR_ID=primary

# Name of the top-level folder created in "My Drive"
DRIVE_ROOT_FOLDER_NAME=LineArchive

# IANA time zone used for day folders, reminders and calendar
TIMEZONE=Asia/Bangkok

# ---- Chat brain (optional but recommended) ----
# Without a key the bot only understands simple keyword commands and cannot
# set reminders or calendar events. Give ONE of these keys:
#   Gemini    - free tier, get a key at https://aistudio.google.com/apikey
#   Anthropic - paid, best quality
# LLM_PROVIDER forces one (gemini | anthropic | none); otherwise auto-detected.
LLM_PROVIDER=
GEMINI_API_KEY=
# Comma-separated list = fallbacks. Free-tier daily quota is counted per model,
# so listing two or three models multiplies what you get for free.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high  (low = fastest, cheapest, plenty for chat)
CLAUDE_EFFORT=low
# Posters and links: always = read them automatically and record deadlines,
# ask = offer a button first, off = archive only. Each read is one AI request.
AUTO_SCAN=always
# What the bot calls itself and what it calls you
BOT_NAME=น้องไดรฟ์
USER_NAME=

# ---- Sharing with family / friends (optional) ----
# A second OAuth client of type "Web application" whose authorised redirect
# URI is https://<your service>/oauth/callback. With it, other people who add
# the bot get a "เชื่อม Google Drive" button and use their own Drive.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# If set, new people must send this word before they can connect.
INVITE_CODE=

# ---- Reminders ----
# Random secret; Cloud Scheduler must send it in the X-Cron-Secret header
CRON_SECRET=

PORT=8080
