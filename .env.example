# ---- LINE Messaging API (LINE Developers Console > your channel) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Your own LINE user ID (starts with "U"). Leave empty on first deploy;
# the bot will reply with your ID so you can copy it here. Comma-separate
# several IDs to allow more than one person.
ALLOWED_USER_IDS=

# ---- Google Drive (Google Cloud Console > OAuth client, "Desktop app") ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced once by `npm run get-token`
GOOGLE_REFRESH_TOKEN=

# Name of the top-level folder created in "My Drive"
DRIVE_ROOT_FOLDER_NAME=LineArchive

# IANA time zone used for the YYYY-MM-DD day folders
TIMEZONE=Asia/Bangkok

PORT=8080
